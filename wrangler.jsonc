{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lnkr",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "TENANT", "class_name": "Tenant" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tenant"] }],
  "vars": { "LD_SESSION_COOKIE_AGE": "1209600" }
}
